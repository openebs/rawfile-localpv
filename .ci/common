#!/usr/bin/env bash

slugify() {
	echo "$1" | sed -r 's/[^.a-zA-Z0-9]+/-/g'
}

echo_stderr() {
	echo -e "${1}" >&2
}

die() {
	local _return="${2:-1}"
	echo_stderr "$1"
	exit "${_return}"
}

export CI_IMAGE_NS=${CI_IMAGE_NS:-"openebs"}
export IMAGE="$CI_IMAGE_NS/rawfile-localpv"
export COMMIT=$(git rev-parse --short HEAD)
export BRANCH=${BRANCH:-$(git rev-parse --abbrev-ref HEAD)}
export IMAGE_TAG=$(git describe --tags --exact-match HEAD 2>/dev/null || :)
export BRANCH_SLUG=$(slugify $BRANCH)

export CI_REGISTRY=${CI_REGISTRY:-"docker.io"}
export CI_IMAGE_REPO="${IMAGE}"
export CI_IMAGE_NAME="${CI_REGISTRY}/${CI_IMAGE_REPO}"
## See `docker system info --format '{{.ClientInfo.Os}}/{{.ClientInfo.Arch}}'` for default platform
export CI_IMAGE_PLATFORMS="local"
export CI_TEST="${CI_TEST:-true}"
export CI_TEST_IMAGE_TAG="${COMMIT}"
if [[ "${CI_TEST}" == "false" ]]; then
	export CI_IMAGE_PLATFORMS="linux/amd64,linux/arm64"
else
	export TAG_SUFFIX="-ci"
fi

# override this for easy testing of a release tag
#export CI_TEST_IMAGE_TAG="v0.15.0"
#export TAG_SUFFIX=""

build-image-tag() {
	printf "%s%s" "${1}" "${TAG_SUFFIX:-}"
}

build-image-uri() {
	printf "%s:%s" "${CI_IMAGE_NAME}" "$(build-image-tag $1)"
}

# Build base (Dockerfile.base: toolchain + grpcio compiled against the FIPS
# OpenSSL), published by .ci/build-base.sh from the Container Images workflow.
# Its tag is a content hash of everything it depends on: Dockerfile.base (which
# includes the pinned builder image digest) and the grpcio version in
# poetry.lock. So the tag only changes when a rebuild is actually needed, is
# the same across branches with identical inputs, and never needs updating by
# hand.
export GRPCIO_VERSION="$(sed -n '/^name = "grpcio"$/{n;s/^version = "\(.*\)"$/\1/p}' "$SCRIPT_DIR/../poetry.lock")"
base-image-uri() {
	local hash
	hash="$( { cat "$SCRIPT_DIR/../Dockerfile.base"; echo "grpcio=${GRPCIO_VERSION}"; } | sha256sum | cut -c1-12)"
	printf "%s:base-%s" "${CI_IMAGE_NAME}" "${hash}"
}
export CI_BASE_IMAGE="$(base-image-uri)"

# True if the base image for the current inputs is published (anonymous read).
base-image-published() {
	docker manifest inspect "${CI_BASE_IMAGE}" >/dev/null 2>&1
}

# Attestations for pushed images: full SLSA provenance (build args, Dockerfile,
# resolved base-image digests) and an SBOM of the final filesystem. Only
# registry outputs can carry them; the docker driver drops them.
export ATTEST_OPTIONS="--provenance=mode=max --sbom=true"
